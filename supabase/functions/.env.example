# ============================================================
# Secrets for the `send-broadcast` Edge Function — SERVER SIDE.
#
# These must NEVER go into .env.local / Vercel / any VITE_ var:
# deploy-time secrets live inside Supabase:
#
#   supabase secrets set BREVO_API_KEY=xkeysib-...
#   supabase secrets set BREVO_SENDER_EMAIL=you@gmail.com
#   supabase secrets set BREVO_SENDER_NAME="Keisha Store"
#
# This file is just a reference, like .env.example elsewhere.
# ============================================================

# Brevo "API key v3" — Brevo → SMTP & API → Generate new API key
BREVO_API_KEY=

# The sender address you verified by clicking Brevo's confirmation
# email (e.g. your Gmail/Outlook). Untested senders get bounced.
BREVO_SENDER_EMAIL=

# Display name shown in the recipient's inbox
BREVO_SENDER_NAME=Keisha Store
