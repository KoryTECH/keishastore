# ============================================================
# Keisha Store — Supabase environment variables (TEMPLATE)
# Copy this file to `.env.local` and paste your real values.
#
# Where to find them: Supabase Dashboard → Settings → API
#   1. Project URL            -> "Project URL"
#   2. anon / publishable key -> "Project API keys" → the one
#      labeled `anon, public` (NOT the service_role secret!)
# ============================================================

VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_ANON_PUBLISHABLE_KEY_HERE
